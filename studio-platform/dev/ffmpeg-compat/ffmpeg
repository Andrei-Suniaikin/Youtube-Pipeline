#!/bin/sh
# Прослойка для локальных прогонов: -vsync → -fps_mode.
#
# Боевой render_worker (Минск) в девяти местах передаёт `-vsync cfr`. ffmpeg выбросил
# этот ключ в 8-й версии, оставив `-fps_mode`. На Linux Mint 22.1 стоит ffmpeg 6, там
# всё работает; homebrew на маке ставит 9 — и каждая пачка картинок падает с
# «Unrecognized option 'vsync'». Рендерер считает это восстановимым, рисует чёрный фон
# и рапортует об успехе: ролик нужной длины, со звуком и без единой картинки.
#
# Движок не трогаем: он побайтово равен минскому, и четвёртая копия на 6117 строк
# разошлась бы с остальными тремя. Подменяем окружение, а не код.
#
# Настоящий ffmpeg подставляет dev/render-node.sh — он же решает, нужна ли прослойка
# вообще (на ffmpeg ≤ 7 её в PATH нет).
: "${VS_REAL_FFMPEG:?путь к настоящему ffmpeg не задан — запускайте через dev/render-node.sh}"

n=$#
i=0
while [ $i -lt $n ]; do
  a=$1
  shift
  [ "$a" = "-vsync" ] && a="-fps_mode"
  set -- "$@" "$a"
  i=$((i + 1))
done

exec "$VS_REAL_FFMPEG" "$@"
