# Скопировать в .env и заполнить. .env в git не попадает (см. .gitignore).
# Ничего из этого файла не является секретом — здесь только имена переменных.

# ─── Телеграм-тревоги ────────────────────────────────────────────────────────
# 1. @BotFather → /newbot → сюда попадает токен вида 123456789:AAH...
VS_TG_TOKEN=
# 2. написать боту сообщение, затем: .venv/bin/python dev/alerts.py --whoami
#    личный чат — положительное число, группа — отрицательное (-100...)
VS_TG_CHAT=

# Пороги тревог. Значения по умолчанию равны написанному в ТЗ; трогать их стоит
# только на время разбора инцидента.
# VS_ALERT_STALL_SEC=1800      очередь не пустая, но 30 мин ничего не завершилось
# VS_ALERT_RESTING_SEC=3600    провайдер на паузе дольше часа
# VS_ALERT_UPLOAD_SEC=10800    есть готовые ролики, но 3 часа ничего не залито
# VS_ALERT_OLDEST_SEC=21600    самая старая задача ждёт дольше 6 часов
# VS_ALERT_DISK_GB=100         на диске меньше 100 ГБ
# VS_ALERT_REPEAT_SEC=3600     повтор не чаще раза в час
# Поводы, добавленные владельцем после ТЗ (07.09, 16.09 и 21.09.2026):
# VS_ALERT_FAILED_SEC=86400        окно, в котором упавшая задача ещё повод
# VS_ALERT_FAILED_MAX=5            сколько падений называем поимённо, остальные — строкой
# VS_ALERT_KEY_EXPIRES_DAYS=7      за сколько дней предупредить, что ключ истекает
# VS_ALERT_USAGE_PCT=90            доля часового лимита картинок, после которой это повод
# VS_ALERT_USAGE_STALE_SEC=7200    снимок расхода старше этого — не повод ни в одну сторону
# VS_ALERT_KEY_REFUSE_HITS=2       сколько отказов провайдера подряд значат «ключ кончился».
#                                  Меньше двух ставить нельзя: одиночный 401 бывает сбоем
#                                  у провайдера, а статистику мы спрашиваем раз в минуту

# ─── Срок хранения проектов ──────────────────────────────────────────────────
# Проект весит около 518 МБ. Здесь задаётся, через сколько дней ПОСЛЕ ПУБЛИКАЦИИ
# от него убирают лишнее. Пустые значения = ничего не удаляется никогда.
#
# strip: удалить кадры, клипы и куски озвучки. Ролик, субтитры, тайм-коды и обложка
#        остаются. Освобождает почти весь объём, но пересобрать ролик заново будет
#        стоить столько же, сколько он стоил в первый раз.
# drop:  удалить проект целиком, вместе с готовым mp4. Только для опубликованных —
#        то есть для тех, что существуют уже не только у нас.
# VS_RETENTION_STRIP_DAYS=14
# VS_RETENTION_DROP_DAYS=90

# Пока эта переменная не выставлена, уборка только СЧИТАЕТ и показывает в «Админ →
# Диск», что было бы удалено и сколько оплаченных вызовов при этом пропало бы.
# Сначала посмотреть отчёт, потом включать.
# VS_RETENTION_AUTO=1
# VS_RETENTION_EVERY_SEC=3600   как часто проверять (не чаще раза в 5 минут)

# ─── Квота YouTube Data API ──────────────────────────────────────────────────
# Ключ один на всё: поздняя проверка «ролик вышел» и ночной обход конкурентов ВВ2
# тратят один и тот же суточный кошелёк. Кончился — это «повторить позже», а не
# поломка ролика; сброс Google делает в полночь по ТИХООКЕАНСКОМУ времени.
#
# VS_YT_QUOTA_UNITS=10000      суточный бюджет в единицах. Умолчание — то, что Google
#                              даёт проекту без заявки. Это НАШЕ представление о чужой
#                              квоте: если владелец просил расширение или проект урезали
#                              после аудита, цифру надо поправить здесь — иначе система
#                              будет винить «другого потребителя» вместо себя.
# VS_YT_RATE_WAIT_SEC=300      пауза после «слишком часто» (rateLimitExceeded). Это НЕ
#                              суточная квота: короткий предел отпускает сам за минуты,
#                              и ждать из-за него до полуночи — потерять день зря.

# ─── Уборка исходников проекта ───────────────────────────────────────────────
# Что делать с папкой `Images/` при уборке по квитанции рендера. Умолчание `keep` —
# «не доказано, что моё, значит не трогаю»: в `Images/**` лежат РУЧНЫЕ материалы
# пользователя, кабинет читает их наравне с генерацией, и ни одна ручка кабинета их
# не создаёт — то есть и не восстановит. Всё остальное (`googler video`, `.thumbs`,
# `_FINAL_AUDIO_*`) убирается независимо от этой переменной.
#
#   keep      (умолчание) — `Images/` не трогаем вообще;
#   generated — удаляем только `Images/<цифры>/**`, ровно ту раскладку, которую
#               создаёт image_worker в старом режиме тегов Bing. Ослабление
#               сознательное: папку с именем из одних цифр может сделать и человек,
#               нумеруя кадры;
#   all       — как в бою: весь `Images/**` считается выхлопом генерации.
#
# Спорность в том, что при `keep` место на проектах со старым Bing-режимом само не
# освободится. Поэтому выбор — здесь, а не зашит в коде (server/source_retention.py).
# VS_SOURCE_RETENTION_IMAGES=keep

# ─── Рендер ──────────────────────────────────────────────────────────────────
# Рендер делает отдельная машина: она опрашивает /api/render/claim с этим токеном.
# Значение общее для платформы и для ноды; пустой токен сервер отвергает всегда.
# Локально нода поднимается через dev/render-node.sh.
# PULLER_TOKEN=

# Возраст, после которого недокачанный `.incoming-*` считается брошенным и удаляется.
# Умолчание выбрано по времени жизни ЖИВОЙ заливки, а не на глаз: нода льёт тело одним
# запросом с timeout=1200 c (dev/render_puller.post_done), то есть у работающей доставки
# mtime файла обновляется минимум раз в двадцать минут, а вся она укладывается в двадцать
# минут целиком. Шесть часов — восемнадцатикратный запас: снести идущую доставку такой
# порог не может, а огрызок от вчерашнего OOM переживёт максимум час до ближайшего тика.
# Спорное место — именно эта цифра, поэтому она в настройке.
# VS_RENDER_INCOMING_MAX_AGE_SEC=21600

# ─── Общий учёт физического ключа (ребейз рерайта на боевой 18.09) ───────────
# Боевой rewrite_core.py импортирует модуль `credential_budget` БЕЗ try и ищет его
# в VIDEO_STUDIO_SHARED_DIR. Нет модуля — не поднимается вся платформа, а не только
# рерайт. В репозитории он лежит в studio-platform/shared/, dev/run.sh подставляет
# этот путь сам; переменные ниже нужны тому, кто поднимает платформу иначе.
#
# VIDEO_STUDIO_SHARED_DIR=/opt/video-studio-shared    где лежит credential_budget.py
# VIDEO_STUDIO_CREDENTIAL_BUDGET_DIR=/run/video-studio-credential-budget
#                              каталог файлов-замков. Обязан быть 0700 и нашим — модуль
#                              проверяет это и иначе падает на первом платном заказе.
#                              Замки должны пережить перезапуск сервиса, но НЕ перезагрузку
#                              машины: в бою поэтому /run (tmpfs).
#
# Потолки одновременных вызовов на ОДИН физический ключ. Умолчания — боевые:
# fastgen 18, openai 12, veo 24, claude_oauth 1, codex 1. Автор боевого модуля сам
# назвал их «осторожной политикой», а не фактом про тариф. Для нас claude_oauth=1
# СТРОЖЕ, чем было: форк 31.08 разрешал три вызова на токен. Цифру меняет владелец,
# и она должна быть ОДНА на всю машину — разные значения в разных процессах ломают
# общий счёт (места нумеруются 0..N-1).
#
# ОГРАНИЧЕНИЕ, КОТОРОЕ НАДО ЗНАТЬ ДО ПЕРЕЕЗДА НА ОБЩИЙ КАТАЛОГ.
# Переменные VIDEO_STUDIO_CREDENTIAL_BUDGET_<СЕМЬЯ> читает ТОЛЬКО наша копия модуля —
# studio-platform/shared/credential_budget.py. В бою модуль общий и лежит в
# /opt/video-studio-shared; там этой правки НЕТ, и про переменные он не знает. Отсюда
# два следствия, оба молчаливые:
#   1. Поставить VIDEO_STUDIO_SHARED_DIR=/opt/video-studio-shared и оставить строки
#      ниже в .env — потолки вернутся к боевым (claude_oauth=1), и никто не скажет
#      ни слова: вместо ошибки будет просто меньше параллельных вызовов.
#   2. Хуже: если один процесс на машине возьмёт НАШУ копию, а другой — боевую,
#      числа у них разойдутся, и общий учёт перестанет быть общим — тот, у кого
#      потолок выше, займёт места, которых сосед не видит.
# Поэтому: либо правку переносят в общий модуль (одним файлом на машину), либо
# строки ниже не трогают. Честный общий учёт физического ключа — задача B8.
#
# VIDEO_STUDIO_CREDENTIAL_BUDGET_CLAUDE_OAUTH=3
# VIDEO_STUDIO_CREDENTIAL_BUDGET_CODEX=1
# VIDEO_STUDIO_CREDENTIAL_BUDGET_OPENAI=12
#
# Две семьи ниже при умолчаниях ПОКА НЕ ИСПОЛЬЗУЮТСЯ: общий учёт зовёт рерайт и только
# для openai / claude_oauth / codex (rewrite_core.py:854), а кабинет при
# VS_KEY_BUDGET_MODE=off (умолчание) в общий счёт не ходит вовсе. Включите режим в
# следующем разделе — и тогда через тот же счёт пойдут картинки FastGen и видео VEO,
# то есть эти две строки начнут работать.
# VIDEO_STUDIO_CREDENTIAL_BUDGET_FASTGEN=18
# VIDEO_STUDIO_CREDENTIAL_BUDGET_VEO=24

# ─── Кабинет в общем учёте ключа (задача B8) ─────────────────────────────────
# Строкой выше сказано, что честный общий учёт — это B8. Вот он. Кабинет умеет брать
# места в том же счёте, что и рерайт, и опознаёт ключ по ВЕНДОРУ, а не по локальному
# имени семейства: `googler` кабинета, `fastgen` обложек и `flow`/`grok` — это один
# физический ключ FastGen, `codex_home` и `codex` — одна подписка ChatGPT.
#
# ЧТО ЭТО МЕНЯЕТ. Сегодня один ключ считают ТРОЕ, каждый по-своему: у провайдера
# получается сумма трёх потолков, и перебор возвращается оплаченными 429. Общий счёт
# превращает сумму в один потолок. Это и есть цель — и это же означает, что кому-то
# станет теснее, чем вчера. Поэтому режим выбирает владелец, а не код:
#
#   off      (умолчание) кабинет мест не занимает и не откладывается. Ровно сегодняшнее
#            поведение: ни кабинет, ни рерайт ничего не замечают.
#   observe  кабинет ЗАНИМАЕТ места, но отказа себе не берёт. Рерайт впервые видит
#            нагрузку кабинета — и значит рерайту станет теснее, а кабинету нет.
#   enforce  занимает и, если мест нет, откладывает СВОЮ задачу (см. ниже).
#
# ЧТО СЧИТАЕТСЯ ЗА МЕСТО. Не задача, а ОДНОВРЕМЕННЫЙ ВЫЗОВ в ключ. Иначе числа
# несравнимы: рерайт на тех же файлах-замках берёт место на КАЖДЫЙ вызов, а одна
# задача кабинета держит столько вызовов, сколько ей выдали потоков.
#
# Числа, которые владелец должен знать до включения enforce. Слева — сколько мест
# берёт ОДНА задача кабинета (замер на умолчаниях, server/main.py::_key_budget_units),
# справа — потолок общего счёта на весь физический ключ:
#   промпты codex      20 вызовов против потолка подписки 1;
#   промпты claude     11 против 1;
#   промпты openai     10 против 12 (то есть две задачи в ключ уже не помещаются);
#   картинки FastGen    3 против 18, а на СВОЁМ ключе владельца замеренные 25 против 18;
#   клипы veo           5 против 24;
#   обложки             в общий счёт ПОКА НЕ ХОДЯТ — их доля лимита не учтена ни в
#                       одном режиме.
# Задача, которой выдали больше потоков, чем весь потолок ключа (codex, claude, свой
# FastGen), берёт ключ ЦЕЛИКОМ и пишет об этом строку в журнал задачи. Молча ужать её
# нельзя: воркер всё равно пойдёт в ключ своими потоками, и учёт стал бы украшением.
# Значит при enforce на codex/claude один канал промптов = одна задача разом; если это
# не то, что нужно, поднимается потолок (VIDEO_STUDIO_CREDENTIAL_BUDGET_* выше, общие
# на машину) или понижается «потоков на проект» в /server-limits.
# VS_KEY_BUDGET_MODE=off
#
# На сколько откладывается задача, которой не хватило места (enforce). Не ждём в
# шедулере намеренно: его тик держит транзакцию очереди, и сон в ней останавливает
# все каналы, а не один занятый ключ. Отложка пишется в queue_tasks.retry_after,
# и в журнал задачи уходит ОДНА строка словами: «ключ …abcd (fastgen): занято 18 из 18».
# VS_KEY_BUDGET_RETRY_SEC=60
#
# Сколько ВСЕГО задача готова ждать чужой ключ, прежде чем будет снята с ошибкой.
# Отдельно от лимита возвратов byok (VS_BYOK_REQUEUE_MAX) намеренно: тот придуман
# против вечного цикла «свой ключ исчез», а занятый соседом ключ — нормальное рабочее
# состояние, и тратить на него пять возвратов значит через пять минут молча перестать
# соблюдать общий счёт. Час — это «сосед работает», а не «что-то сломалось»; дольше —
# уже повод посмотреть на соседний сервис, и текст ошибки говорит именно это.
# VS_KEY_BUDGET_WAIT_MAX_SEC=3600

# ─── Потоки в задаче рерайта ─────────────────────────────────────────────────
# REWRITE_MAX_THREADS_PER_JOB=3   сколько кусков рерайт обрабатывает одновременно
#
# Переменную читают ДВОЕ: сам рерайт (rewrite/api.py, он зажимает присланное число)
# и кабинет (server/pub_remote.py, он тем же числом считает ключ повтора заказа).
# Значение обязано быть ОДНО на машину. Разойдутся — разойдётся и смысл ключа:
# у кабинета потолок выше, чем у рерайта, — две правки пресета дадут кабинету два
# ключа на ОДНО тело, и после потерянного ответа на POST появится ВТОРАЯ ОПЛАЧЕННАЯ
# задача; ниже — один ключ на два разных тела, то есть 409 и красный выпуск навсегда.
# В единой платформе оба живут в одном процессе, и вопрос снимается сам.

# ─── Где что лежит ───────────────────────────────────────────────────────────
# VS_TENANTS_DIR=/data/tenants   каталог проектов: по нему считается место на диске
# VS_DEV_DB=                     база для локального запуска
