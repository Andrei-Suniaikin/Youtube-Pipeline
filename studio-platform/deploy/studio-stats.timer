[Unit]
Description=Studio: снимать статистику каналов раз в сутки

[Timer]
# Ночью по нашему времени: суточная квота YouTube сбрасывается в полночь по
# тихоокеанскому (это наше утро), так что к этому часу кошелёк заведомо полон, а
# ночной проход тревог и выпусков уже отработал.
OnCalendar=*-*-* 04:20:00
# Разброс, чтобы снимок не попадал в ту же секунду, что и остальная ночная работа.
RandomizedDelaySec=600
# Машина была выключена в свой час — снять снимок сразу после включения. Пропущенный
# день не восстанавливается ничем: YouTube помнит только «сейчас».
Persistent=true

[Install]
WantedBy=timers.target
