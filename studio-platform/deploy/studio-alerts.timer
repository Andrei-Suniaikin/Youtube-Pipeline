[Unit]
Description=Studio: проверять поводы для тревоги раз в три минуты

[Timer]
# Минута — не про скорость реакции, а про точность момента: пороги в поводах измеряются
# получасами и часами, а частый опрос нужен, чтобы «починилось» приходило сразу, а не
# через полчаса после того, как всё наладилось.
OnBootSec=2min
# 21.10.2026: после перезапуска таймера (daemon-reload, деплой) OnUnitActiveSec не
# срабатывает, пока службу не запустят хоть раз, — тревоги молчали три дня (18.10 14:01 →
# 21.10 09:42), и это выглядело как «всё хорошо». OnActiveSec даёт первый проход сразу
# после (пере)запуска самого таймера, дальше цепочка идёт по OnUnitActiveSec.
# 22.10.2026: проверка ела 10–15 с CPU каждую минуту на 6-ядерном VPS под load 20 —
# раз в три минуты: опоздание тревоги на две минуты дешевле четверти ядра.
OnActiveSec=1min
OnUnitActiveSec=3min
# Одновременный старт нескольких проходов бессмысленен: состояние одно на всех.
AccuracySec=10s
Persistent=true
Unit=studio-alerts.service

[Install]
WantedBy=timers.target
