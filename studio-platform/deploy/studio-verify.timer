[Unit]
Description=Studio: спрашивать YouTube, вышли ли ролики, раз в полчаса

[Timer]
# Полчаса — не «почаще, чтобы поновее», а ровно шаг самой проверки. Один и тот же
# ролик она не спрашивает чаще, чем раз в `pub_verify.RECHECK_SEC` (30 мин): проход
# раз в десять минут дал бы те же ответы и три четверти строк «пропущено как недавно
# спрошенное». Реже полчаса — подтверждение выхода опаздывает на ровно столько же.
#
# Сколько это стоит. Один `videos.list` = 1 единица из 10 000 суточных
# (`pub_calls.QUOTA_COSTS`, `YT_DAILY_UNITS`), кошелёк общий с ночным обходом ВВ2 и
# суточной статистикой каналов. Первый вопрос про ролик задаётся через полчаса после
# слота (`GRACE_SEC`), терпение кончается через шесть часов (`GIVE_UP_SEC`) — значит
# на один выпуск приходится от 1 вопроса (вышел вовремя) до 12 (молчал все шесть
# часов). При полутора сотнях выпусков в сутки это от 150 до 1800 единиц — от 1,5% до
# 18% кошелька. Помеченный к разбору выпуск дальше спрашивается раз в сутки
# (`STALE_RECHECK_SEC`), а не раз в полчаса: иначе сотня залежавшихся роликов сама по
# себе съедала бы 4800 единиц в сутки — половину бюджета — и делала бы цифру выше
# неправдой.
#
# Сравнение для веса: статистика каналов тратит три единицы в сутки, то есть выбор
# частоты здесь — единственное место, где проверка может стать заметной для соседей.
OnCalendar=*:00/30
# Разброс, чтобы полсотни проходов в сутки не попадали в ту же секунду, что ночной
# обход и снимок статистики.
RandomizedDelaySec=120
AccuracySec=30s
# Машина была выключена — спросить сразу после включения, а не ждать следующего
# получаса. Persistent работает только вместе с OnCalendar, поэтому расписание здесь
# календарное, а не OnUnitActiveSec.
Persistent=true
Unit=studio-verify.service

[Install]
WantedBy=timers.target
